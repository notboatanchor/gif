# =============================================================================
# gif — Environment Configuration
# Copy this file to .env and fill in values before running docker compose up.
#
#   cp .env.example .env
#
# Never commit .env — it is gitignored.
# =============================================================================

# PostgreSQL superuser password (Docker-managed postgres user)
POSTGRES_PASSWORD=changeme

# gif_admin: schema owner and migration user. Not used at runtime by the MCP server.
GIF_ADMIN_PASSWORD=changeme

# gif_app: enforcement engine application user. Used by the MCP server at runtime.
# Also used by integration tests when connecting as gif_app.
GIF_APP_PASSWORD=changeme

# Database name (default: gif)
PGDATABASE=gif

# Host port for PostgreSQL (default: 5432). Change if 5432 is already in use on your machine.
PGPORT_HOST=5432

# MCP server port (default: 3100)
PORT=3100

# Host address the two published ports above bind to (default: 127.0.0.1 —
# reachable from this machine only). Without a host address Docker publishes
# a port on every interface, and it does so ahead of ufw-style host firewall
# rules. Set 0.0.0.0 (all IPv4 interfaces) or one specific interface address
# only when another machine, or a container outside this compose project,
# must connect directly — and only after replacing every `changeme` password
# above.
# For a network-facing deployment, keep the default and put a TLS reverse
# proxy in front: docs/runbooks/adopter/production-deployment.md.
# GIF_BIND_ADDR=127.0.0.1

# Shutdown drain bound in seconds (default: 8). On SIGTERM/SIGINT the server
# finishes in-flight tool calls and their audit writes before exiting; past
# this bound it force-exits nonzero. Keep below the orchestrator's kill grace
# (Docker default: 10s) so the forced-exit path can log before SIGKILL.
# GIF_SHUTDOWN_TIMEOUT_SECONDS=8

# HMAC secret for identity token signing (Sprint 5 compliance hardening).
# Required for persona_create tool and identity binding tests.
#
# REQUIRED: replace the placeholder value below before starting the server.
# The server refuses to start if IDENTITY_HMAC_SECRET is left as this
# placeholder, or is set to any value shorter than 32 bytes — a short or
# publicly known signing key lets anyone forge a valid identity_token for
# persona_create. Generate a strong value with:
#   openssl rand -hex 32
IDENTITY_HMAC_SECRET=changeme-use-openssl-rand-hex-32
